# ====== App Manutenção — exemplo de variáveis de ambiente ======
# Copie para `.env` e preencha. Nunca commitar `.env`.

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json

# Auth JWT — EM PRODUÇÃO use >=32 chars aleatórios (ex: openssl rand -hex 32)
JWT_SECRET=change-me-in-production-min-32-chars

# OAuth
OAUTH_SERVER_URL=
VITE_APP_ID=app-manutencao-local

# Frontend → backend (preencher quando frontend Vercel apontar para backend Hetzner)
# Exemplo: https://api.appmanutencao.com.br/api/trpc
VITE_API_URL=

# Owner
OWNER_OPEN_ID=

# Forge (opcional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Resend (envio de e-mails)
RESEND_API_KEY=

# AWS S3 (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Servidor
PORT=3000

# CRON
CRON_SECRET=
