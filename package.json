  "scripts": {
    "dev": "tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --external:./vite --external:./vite.js && pnpm build:migrar && pnpm build:admin",
    "build:migrar": "esbuild scripts/db/migrar.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/migrar.js",
